# ───────── Serveur Frère Flow ─────────
PORT=4000

# Adresse MongoDB Atlas (les collections de ce serveur sont préfixées ff_)
# Exemple : mongodb+srv://ferme_app:MOTDEPASSE@ferme.xxxxx.mongodb.net/ferme?retryWrites=true&w=majority&appName=ferme
MONGO_URI=

# Clé secrète des sessions : laissez vide, elle est générée automatiquement au 1er démarrage (propre à ce PC)
JWT_SECRET=

# Session : durée maximale (heures) et déconnexion après inactivité (minutes)
SESSION_HOURS=8
IDLE_MINUTES=30

# ───────── Démonstration (mettre false pour le client) ─────────
DEMO_LOGIN=false
ALLOW_DEMO_RESET=false
# Premier démarrage sur une base vide : demo (démonstration) ou propre (configuration seule)
SEED_MODE=demo
# Mot de passe du compte direction@ pour SEED_MODE=propre (8 caractères, lettres + chiffres)
ADMIN_PASSWORD=

# ───────── Sauvegardes ─────────
# Sauvegarde automatique toutes les N heures dans le dossier sauvegardes/ (0 = jamais)
BACKUP_HOURS=24
BACKUP_KEEP=14
# Clé de chiffrement des sauvegardes (32 caractères ou plus, à conserver précieusement : sans elle, pas de restauration)
BACKUP_KEY=

# ───────── Production (voir SECURITE.md) ─────────
# NODE_ENV=production
# CORS_ORIGIN=https://gestion.frere-mahjoub.tn
# COOKIE_SECURE=true
# TRUST_PROXY=true

# ── Mode de connexion « code par email » (facultatif) ──
# Exemple Gmail : activez la validation en 2 étapes du compte Gmail, puis créez un
# « mot de passe d'application » (myaccount.google.com → Sécurité) et collez-le dans SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Anti-saturation : opérations (enregistrements) par compte et par minute
OPS_USER_LIMIT=120

# ───────── Site qui relaie /api (ex. Render, site et API à deux adresses) ─────────
# Même valeur que PROXY_SECRET du site (32 caractères minimum) : seul le site peut transmettre
# l'adresse IP réelle des visiteurs (limites anti-abus par visiteur et non par serveur)
# PROXY_SECRET=
