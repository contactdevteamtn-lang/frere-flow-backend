# Mise en production sécurisée avec Caddy (https://caddyserver.com) — certificat HTTPS automatique.
# Remplacez gestion.frere-mahjoub.tn par votre nom de domaine (enregistrement DNS A vers le serveur).
#
# Le site et l'API sont servis à la MÊME adresse (https://gestion.frere-mahjoub.tn et .../api) :
#   - site  : npm run build dans frere-flow (NITRO_PRESET=node-server, VITE_API_URL=/api)
#             puis node .output/server/index.mjs  (port 3000)
#   - API   : npm start dans frere-flow-backend (port 4000) avec dans .env :
#             NODE_ENV=production  CORS_ORIGIN=https://gestion.frere-mahjoub.tn  TRUST_PROXY=true
#             COOKIE_SECURE=true  DEMO_LOGIN=false  ALLOW_DEMO_RESET=false  BACKUP_KEY=...

# Options globales : vraie adresse du visiteur derrière Cloudflare + délais anti-connexions lentes.
# Plages Cloudflare : https://www.cloudflare.com/ips/ (à revérifier de temps en temps).
# Sans Cloudflare, ces lignes sont sans effet : l'adresse de la connexion est utilisée.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

gestion.frere-mahjoub.tn {
	encode zstd gzip

	# journal d'accès JSON : lu par Fail2Ban (connexions refusées) — rotation automatique
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# API (le serveur Node n'est jamais exposé directement : ports 3000/4000 fermés au public)
	handle /api/* {
		request_body {
			max_size 2MB
		}
		# adresse réelle du visiteur (le serveur Node prend la dernière adresse de X-Forwarded-For)
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
